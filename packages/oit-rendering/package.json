{
  "name": "zephyr3d-example-oit-rendering",
  "version": "0.0.1",
  "description": "zephyr3d order-independent transparency example",
  "private": "true",
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "shx rm -rf dist .tsbuildinfo",
    "build:check": "tsc -p . --noEmit",
    "build": "cross-env NODE_OPTIONS=--max_old_space_size=8192 rollup -c --silent",
    "lint": "cross-env NODE_OPTIONS=--max_old_space_size=8192 eslint \"src/**/*.ts\" -f compact",
    "serve": "web-dev-server --no-cache --watch --open dist/index.html"
  },
  "devDependencies": {
    "@web/dev-server": "^0.1.35",
    "@rollup/plugin-node-resolve": "~16.0.0",
    "rollup": "~4.30.1",
    "rollup-plugin-swc3": "~0.12.1",
    "rollup-plugin-copy": "^3.4.0",
    "@swc/core": "^1.3.62",
    "shx": "^0.3.4",
    "cross-env": "^7.0.3",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@webgpu/types": "^0.1.65",
    "@zephyr3d/base": "^0.2.10",
    "@zephyr3d/device": "^0.2.19",
    "@zephyr3d/scene": "^0.9.27",
    "@zephyr3d/backend-webgl": "^0.1.18",
    "@zephyr3d/backend-webgpu": "^0.1.21",
    "@rollup/plugin-commonjs": "~28.0.2"
  }
}
